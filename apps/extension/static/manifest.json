{
  "manifest_version": 3,
  "name": "Caiji Collector",
  "version": "0.1.0",
  "description": "采集 1688 商品到 Caiji 工作台",
  "permissions": ["storage"],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "*://*.1688.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.1688.com/offer/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Caiji Collector"
  }
}
