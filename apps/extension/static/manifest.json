{
  "manifest_version": 3,
  "name": "V2Store Collector",
  "version": "0.1.0",
  "description": "采集 1688 商品到 V2Store 工作台",
  "permissions": ["storage", "contextMenus"],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "*://*.1688.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.1688.com/*", "*://1688.com/*"],
      "js": ["collect1688-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.1688.com/offer/*",
        "*://*.1688.com//offer/*",
        "*://*.1688.com/detail/*",
        "*://detail.m.1688.com/*",
        "*://detailp4p.1688.com/buyer/offerdetail/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://s.1688.com/*"],
      "js": ["search.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://localhost:5173/*", "http://127.0.0.1:5173/*"],
      "js": ["site-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "V2Store Collector"
  }
}
