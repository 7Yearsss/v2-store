# Copy to apps/server/.env. Everything is optional in development.

# Postgres. Leave unset to use embedded PGlite at PGLITE_DIR (dev only).
# DATABASE_URL=postgres://caiji:caiji@localhost:5432/caiji
# PGLITE_DIR=./data/pglite

# Public origin of the web app (cookies + OAuth redirect base).
APP_URL=http://localhost:5173

# 32 bytes, hex or base64 — encrypts store credentials. REQUIRED in production.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ENCRYPTION_KEY=

# Shopify public app (enables the one-click OAuth install).
# App redirect URL: ${APP_URL}/api/shopify/callback
# Webhooks (app/uninstalled + privacy topics): ${APP_URL}/api/shopify/webhooks
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# SHOPIFY_SCOPES=write_products,read_products,read_inventory,write_inventory,read_locations
# SHOPIFY_API_VERSION=2026-07

# Run the job worker in the API process (set false when running workers separately).
# RUN_WORKER=true

# Media storage. Default: local disk at MEDIA_DIR (dev).
# Cloudflare R2: set all of the following (R2 → Manage API tokens → Object Read & Write,
# scoped to the bucket). Bucket "v2-store" already exists.
# MEDIA_DIR=./data/media
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=v2-store
